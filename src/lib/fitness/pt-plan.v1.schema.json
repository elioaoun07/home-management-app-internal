{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "era.fitness.pt-plan.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "trainer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_weeks": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 104
        },
        {
          "type": "null"
        }
      ]
    },
    "workout_order": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "workouts": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "strength",
              "cardio",
              "mobility",
              "recovery"
            ]
          },
          "estimated_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "exercises": {
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "warmup",
                    "main",
                    "cooldown"
                  ]
                },
                "equipment": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "group_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "group_mode": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "superset",
                    "circuit"
                  ]
                },
                "sets": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "warmup",
                          "working"
                        ]
                      },
                      "reps_min": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reps_max": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "duration_seconds": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 86400
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "distance_m": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "load_kg": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "load_kind": {
                        "type": "string",
                        "enum": [
                          "external",
                          "bodyweight",
                          "assisted",
                          "unspecified"
                        ]
                      },
                      "rpe": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 10
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "rir": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "rest_seconds": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3600
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "tempo": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "notes": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "reps_min",
                      "reps_max",
                      "duration_seconds",
                      "distance_m",
                      "load_kg",
                      "load_kind",
                      "rpe",
                      "rir",
                      "rest_seconds",
                      "tempo",
                      "notes"
                    ],
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "phase",
                "equipment",
                "group_id",
                "group_mode",
                "sets",
                "notes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "estimated_minutes",
          "notes",
          "exercises"
        ],
        "additionalProperties": false
      }
    },
    "progression_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "message",
          "blocking"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "trainer",
    "goal",
    "duration_weeks",
    "workout_order",
    "workouts",
    "progression_notes",
    "source_notes",
    "issues"
  ],
  "additionalProperties": false
}
