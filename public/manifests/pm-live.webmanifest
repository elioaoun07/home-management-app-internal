{
  "id": "/pm-live-app",
  "name": "PM Live • ERA",
  "short_name": "PM Live",
  "description": "Phone command surface for the PM Command Center — checklist, delivery fleet, and campaigns, live from the laptop bridge.",
  "start_url": "/pm/live",
  "scope": "/pm/live",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0a1628",
