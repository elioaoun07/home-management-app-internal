{
  "permissions": {
    "allow": [
      "PowerShell(npx vitest run 2>&1)",
      "PowerShell(npm run dev 2>&1)"
    ],
    "deny": [
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__claude_ai_Supabase__delete_branch",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "mcp__claude_ai_Supabase__rebase_branch",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__restore_project",
      "mcp__claude_ai_Supabase__confirm_cost",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__confirm_cost",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(pnpm supabase:*)",
      "Bash(pnpm dlx supabase:*)",
      "Bash(psql:*)",
      "PowerShell(supabase*)",
      "PowerShell(npx supabase*)",
      "PowerShell(psql*)",
      "PowerShell(pnpm supabase*)",
      "PowerShell(pnpm dlx supabase*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs session-brief SessionStart -- bash .claude/hooks/session-brief.sh",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs block-ui-dir PreToolUse -- bash .claude/hooks/block-ui-dir.sh",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs sync-ai-mirrors PostToolUse -- node scripts/sync-ai-mirrors.mjs --hook",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs update-atlas PostToolUse -- bash .claude/hooks/update-atlas.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs check-migration PostToolUse -- bash .claude/hooks/check-migration.sh",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/os/hook.mjs check-pm-update Stop -- bash .claude/hooks/check-pm-update.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
