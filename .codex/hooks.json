{
  "description": "Generated from .claude/settings.json by pnpm sync:ai; do not edit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" SessionStart 0 0",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') SessionStart 0 0; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" PreToolUse 0 0",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') PreToolUse 0 0; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" PostToolUse 0 0",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') PostToolUse 0 0; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" PostToolUse 0 1",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') PostToolUse 0 1; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" PostToolUse 0 2",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') PostToolUse 0 2; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook.mjs\" Stop 0 0",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel) 'scripts/run-agent-hook.mjs') Stop 0 0; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
